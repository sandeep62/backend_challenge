generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Block {
  number  Int           @id
  hash    String        @unique
  txCount Int
  transactions Transaction[]
}

model Transaction {
  id          Int    @id @default(autoincrement())
  blockNumber Int
  hash        String @unique
  from        String
  to          String
  amount      Float
  nonce       Int
  block       Block  @relation(fields: [blockNumber], references: [number])
}
